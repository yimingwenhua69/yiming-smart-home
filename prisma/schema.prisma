generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id               String   @id @default(cuid())
  name             String
  category         String
  protocol         String
  priceCents       Int?
  priceNote        String?
  installCondition String
  selectionPoints  String[]
  tags             String[]
  description      String
  scenes           Scene[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Scene {
  id          String   @id @default(cuid())
  name        String
  description String
  sortOrder   Int      @default(0)
  devices     Device[]
}
